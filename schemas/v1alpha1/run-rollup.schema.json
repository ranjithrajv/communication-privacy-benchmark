{
  "$defs": {
    "CheckRef": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Check Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "version"
      ],
      "title": "CheckRef",
      "type": "object"
    },
    "CheckRollup": {
      "additionalProperties": false,
      "description": "Repeated-measurement summary for one check against one subject.",
      "properties": {
        "check": {
          "$ref": "#/$defs/CheckRef"
        },
        "decisive_count": {
          "minimum": 0,
          "title": "Decisive Count",
          "type": "integer"
        },
        "expected_observations": {
          "exclusiveMinimum": 0,
          "title": "Expected Observations",
          "type": "integer"
        },
        "fail_count": {
          "minimum": 0,
          "title": "Fail Count",
          "type": "integer"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/RollupOutcome"
        },
        "pass_count": {
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "pass_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rate"
        },
        "pass_rate_high": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rate High"
        },
        "pass_rate_low": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rate Low"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "statuses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatusTally"
          },
          "title": "Statuses",
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        }
      },
      "required": [
        "check",
        "subject",
        "outcome",
        "observations",
        "expected_observations",
        "pass_count",
        "fail_count",
        "decisive_count"
      ],
      "title": "CheckRollup",
      "type": "object"
    },
    "CompletionState": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "CompletionState",
      "type": "string"
    },
    "PlatformDefinition": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "device_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Model"
        },
        "is_emulator": {
          "default": false,
          "title": "Is Emulator",
          "type": "boolean"
        },
        "os": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Os",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "os"
      ],
      "title": "PlatformDefinition",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "inconclusive",
        "not_applicable",
        "unsupported",
        "error",
        "not_tested"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RollupOutcome": {
      "description": "Stability verdict for one check across all planned repetitions.\n\nOnly :attr:`PASS` and :attr:`FAIL` are decisive product properties.  Every other\nvalue states that the observed sample does not establish one, which is why the\nlongitudinal comparison refuses to order them.",
      "enum": [
        "pass",
        "fail",
        "flaky",
        "inconclusive",
        "not_applicable",
        "unsupported",
        "incomplete"
      ],
      "title": "RollupOutcome",
      "type": "string"
    },
    "StatusTally": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        }
      },
      "required": [
        "status",
        "count"
      ],
      "title": "StatusTally",
      "type": "object"
    },
    "SubjectRef": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "subject_version"
      ],
      "title": "SubjectRef",
      "type": "object"
    },
    "SubjectRollup": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckRollup"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "client_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Name"
        },
        "client_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Version"
        },
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlatformDefinition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        }
      },
      "required": [
        "subject",
        "checks"
      ],
      "title": "SubjectRollup",
      "type": "object"
    }
  },
  "$id": "urn:communication-privacy-benchmark:schema:run-rollup:1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Repetition-level summary of one run bundle.\n\nA rollup is derived analysis, never a benchmark result.  It summarizes how stable\neach per-check outcome was across the planned repetitions.",
  "properties": {
    "bundle_completion": {
      "$ref": "#/$defs/CompletionState"
    },
    "bundle_created_at": {
      "format": "date-time",
      "title": "Bundle Created At",
      "type": "string"
    },
    "bundle_id": {
      "format": "uuid",
      "title": "Bundle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "repetitions": {
      "maximum": 20,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "rollup_id": {
      "format": "uuid",
      "title": "Rollup Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1alpha1",
      "default": "1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/SubjectRollup"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    },
    "suite_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Suite Version",
      "type": "string"
    }
  },
  "required": [
    "rollup_id",
    "bundle_id",
    "suite_id",
    "suite_version",
    "plan_id",
    "created_at",
    "bundle_created_at",
    "bundle_completion",
    "repetitions",
    "subjects"
  ],
  "title": "RunRollup",
  "type": "object"
}
