    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "execution_manifests": {
      "items": {
        "$ref": "#/$defs/ExecutionManifest"
      },
      "title": "Execution Manifests",
      "type": "array"
    },
    "missing_subjects": {
      "default": [],
