{
  "$defs": {
    "AccountDefinition": {
      "additionalProperties": false,
      "properties": {
        "account_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Account Type",
          "type": "string"
        },
        "authentication_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Authentication Method",
          "type": "string"
        },
        "slot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Slot Id",
          "type": "string"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "account_type",
        "slot_id",
        "authentication_method"
      ],
      "title": "AccountDefinition",
      "type": "object"
    },
    "CheckRef": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Check Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "version"
      ],
      "title": "CheckRef",
      "type": "object"
    },
    "CompletionState": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "CompletionState",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "distribution_channel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution Channel"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "package_identifier": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Identifier"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "ConfigurationSetting": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "value_redacted": {
          "default": false,
          "title": "Value Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "ConfigurationSetting",
      "type": "object"
    },
    "ExecutionManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Adapter Ids",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completion": {
          "$ref": "#/$defs/CompletionState"
        },
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "github": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitHubProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ResultFileRef"
          },
          "title": "Results",
          "type": "array"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/SubjectDefinition"
        }
      },
      "required": [
        "execution_id",
        "run_id",
        "plan_id",
        "repetition",
        "subject",
        "execution_mode",
        "adapter_ids",
        "started_at",
        "completed_at",
        "completion",
        "results"
      ],
      "title": "ExecutionManifest",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "github_actions",
        "local"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "GitHubProvenance": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit Sha",
          "type": "string"
        },
        "job": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Job",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "run_attempt": {
          "exclusiveMinimum": 0,
          "title": "Run Attempt",
          "type": "integer"
        },
        "run_id": {
          "exclusiveMinimum": 0,
          "title": "Run Id",
          "type": "integer"
        },
        "workflow": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "workflow",
        "job",
        "run_id",
        "run_attempt",
        "commit_sha"
      ],
      "title": "GitHubProvenance",
      "type": "object"
    },
    "NetworkVantage": {
      "additionalProperties": false,
      "properties": {
        "asn": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asn"
        },
        "country_code": {
          "maxLength": 2,
          "minLength": 2,
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "network_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Network Type",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "proxy": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy"
        },
        "public_ip_observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Ip Observed"
        },
        "vantage_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Vantage Id",
          "type": "string"
        }
      },
      "required": [
        "vantage_id",
        "country_code",
        "network_type"
      ],
      "title": "NetworkVantage",
      "type": "object"
    },
    "PlatformDefinition": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "device_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Model"
        },
        "is_emulator": {
          "default": false,
          "title": "Is Emulator",
          "type": "boolean"
        },
        "os": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Os",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "os"
      ],
      "title": "PlatformDefinition",
      "type": "object"
    },
    "ResultFileRef": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Check Id",
          "type": "string"
        },
        "path": {
          "pattern": "^results/[a-z0-9._-]+\\.json$",
          "title": "Path",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "version",
        "status",
        "path"
      ],
      "title": "ResultFileRef",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "inconclusive",
        "not_applicable",
        "unsupported",
        "error",
        "not_tested"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RunPlan": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckRef"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "expected_execution_count": {
          "exclusiveMinimum": 0,
          "title": "Expected Execution Count",
          "type": "integer"
        },
        "github": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitHubProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "repetitions": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/SubjectRef"
          },
          "minItems": 1,
          "title": "Subjects",
          "type": "array"
        },
        "suite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Suite Version",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "name",
        "suite_id",
        "suite_version",
        "created_at",
        "execution_mode",
        "checks",
        "subjects",
        "expected_execution_count"
      ],
      "title": "RunPlan",
      "type": "object"
    },
    "SubjectConfiguration": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "default": "default",
          "maxLength": 100,
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "settings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfigurationSetting"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "title": "SubjectConfiguration",
      "type": "object"
    },
    "SubjectDefinition": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountDefinition"
        },
        "client": {
          "$ref": "#/$defs/ComponentRef"
        },
        "configuration": {
          "$ref": "#/$defs/SubjectConfiguration"
        },
        "network_vantage": {
          "$ref": "#/$defs/NetworkVantage"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "platform": {
          "$ref": "#/$defs/PlatformDefinition"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "subject_version",
        "client",
        "platform",
        "account",
        "network_vantage"
      ],
      "title": "SubjectDefinition",
      "type": "object"
    },
    "SubjectRef": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "subject_version"
      ],
      "title": "SubjectRef",
      "type": "object"
    }
  },
  "$id": "urn:communication-privacy-benchmark:schema:run-bundle:1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "format": "uuid",
      "title": "Bundle Id",
      "type": "string"
    },
    "completion": {
      "$ref": "#/$defs/CompletionState"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "execution_manifests": {
      "items": {
        "$ref": "#/$defs/ExecutionManifest"
      },
      "title": "Execution Manifests",
      "type": "array"
    },
    "missing_subjects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SubjectRef"
      },
      "title": "Missing Subjects",
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/RunPlan"
    },
    "result_count": {
      "minimum": 0,
      "title": "Result Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1alpha1",
      "default": "1alpha1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "plan",
    "created_at",
    "completion",
    "execution_manifests",
    "result_count",
    "evidence_count"
  ],
  "title": "RunBundleManifest",
  "type": "object"
}
