      },
      "title": "Missing Subjects",
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/RunPlan"
    },
    "result_count": {
      "minimum": 0,
      "title": "Result Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1alpha1",
      "default": "1alpha1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "plan",
    "created_at",
    "completion",
    "execution_manifests",
    "result_count",
    "evidence_count"
  ],
  "title": "RunBundleManifest",
  "type": "object"
}
