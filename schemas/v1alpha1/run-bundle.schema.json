        "profile": {
          "default": "default",
          "maxLength": 100,
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "settings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfigurationSetting"
          },
          "title": "Settings",
          "type": "array"
        }
      },
      "title": "SubjectConfiguration",
      "type": "object"
    },
    "SubjectDefinition": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountDefinition"
        },
        "chat": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatAutomation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "client": {
          "$ref": "#/$defs/ComponentRef"
        },
        "configuration": {
          "$ref": "#/$defs/SubjectConfiguration"
        },
        "network_vantage": {
          "$ref": "#/$defs/NetworkVantage"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "platform": {
          "$ref": "#/$defs/PlatformDefinition"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        },
        "webmail": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebmailAutomation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "subject_id",
        "subject_version",
        "client",
        "platform",
        "account",
        "network_vantage"
      ],
      "title": "SubjectDefinition",
      "type": "object"
    },
    "SubjectObservation": {
      "additionalProperties": false,
      "description": "A subject reference bound to the runtime facts a result is attributable to.",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientObservation"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/PlatformObservation"
        },
        "schema_version": {
          "const": "1alpha1",
          "default": "1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "vantage": {
          "$ref": "#/$defs/VantageObservation"
        }
      },
      "required": [
        "observation_id",
        "subject",
        "observed_at",
        "client",
        "platform",
        "vantage"
      ],
      "title": "SubjectObservation",
      "type": "object"
    },
    "SubjectRef": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "subject_version"
      ],
      "title": "SubjectRef",
      "type": "object"
    },
    "VantageObservation": {
      "additionalProperties": false,
      "description": "Where the measurement was taken, as seen by the canary.",
      "properties": {
        "asn": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asn"
        },
        "country_code": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "detail": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Detail",
          "type": "object"
        },
        "observed_public_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Public Ip"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "vantage_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vantage Id"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "VantageObservation",
      "type": "object"
    },
    "WebmailAutomation": {
      "additionalProperties": false,
      "description": "How the harness drives a webmail subject's own UI.\n\nThe recipe is data rather than code so that choosing a webmail provider is a change\nto a checked-in subject, not a branch of the adapter. That matters for the benchmark\nin both directions: a new provider must not require re-reading the adapter to know\nwhat it will drive, and a recipe cannot quietly encode a provider's behaviour the way\na hardcoded call site can.\n\nSelectors are Playwright selector strings. They are part of the subject because a\nrecipe that silently stopped matching its product would otherwise turn into a\nreported ``pass``: the run would open nothing, the canary would record nothing, and\nthe absence would be indistinguishable from a client that fetched no remote content.\nThe adapter treats an unresolvable selector as a harness ``error`` for that reason.",
      "properties": {
        "entry_url": {
          "maxLength": 2048,
          "pattern": "^https://[^\\s/?#]+[^\\s]*$",
          "title": "Entry Url",
          "type": "string"
        },
        "login_timeout_seconds": {
          "default": 60,
          "maximum": 600,
          "minimum": 5,
          "title": "Login Timeout Seconds",
          "type": "integer"
        },
        "message_body": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message Body",
          "type": "string"
        },
        "message_open": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message Open",
          "type": "string"
        },
        "message_row": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message Row",
          "type": "string"
        },
        "open_timeout_seconds": {
          "default": 60,
          "maximum": 600,
          "minimum": 5,
          "title": "Open Timeout Seconds",
          "type": "integer"
        },
        "password_field": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Password Field",
          "type": "string"
        },
        "ready_marker": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Ready Marker",
          "type": "string"
        },
        "sign_out_field": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sign Out Field"
        },
        "submit_field": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Submit Field",
          "type": "string"
        },
        "user_field": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "User Field",
          "type": "string"
        }
      },
      "required": [
        "entry_url",
        "user_field",
        "password_field",
        "submit_field",
        "message_row",
        "message_open",
        "message_body",
        "ready_marker"
      ],
      "title": "WebmailAutomation",
      "type": "object"
    }
  },
  "$id": "urn:communication-privacy-benchmark:schema:run-bundle:1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
