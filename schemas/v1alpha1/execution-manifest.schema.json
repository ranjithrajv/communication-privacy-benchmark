{
  "$defs": {
    "AccountDefinition": {
      "additionalProperties": false,
      "properties": {
        "account_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Account Type",
          "type": "string"
        },
        "authentication_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Authentication Method",
          "type": "string"
        },
        "slot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Slot Id",
          "type": "string"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "account_type",
        "slot_id",
        "authentication_method"
      ],
      "title": "AccountDefinition",
      "type": "object"
    },
    "ClientObservation": {
      "additionalProperties": false,
      "description": "What was really running, as opposed to what the definition asserts.",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "detail": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Detail",
          "type": "object"
        },
        "distribution_channel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution Channel"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "package_identifier": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Identifier"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "ClientObservation",
      "type": "object"
    },
    "CompletionState": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "CompletionState",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "distribution_channel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution Channel"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "package_identifier": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Identifier"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "ConfigurationSetting": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "value_redacted": {
          "default": false,
          "title": "Value Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "ConfigurationSetting",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "github_actions",
        "local"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FieldStatus": {
      "enum": [
        "observed",
        "unavailable"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GitHubProvenance": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit Sha",
          "type": "string"
        },
        "job": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Job",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "run_attempt": {
          "exclusiveMinimum": 0,
          "title": "Run Attempt",
          "type": "integer"
        },
        "run_id": {
          "exclusiveMinimum": 0,
          "title": "Run Id",
          "type": "integer"
        },
        "workflow": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "workflow",
        "job",
        "run_id",
        "run_attempt",
        "commit_sha"
      ],
      "title": "GitHubProvenance",
      "type": "object"
    },
    "NetworkVantage": {
      "additionalProperties": false,
      "properties": {
        "asn": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asn"
        },
        "country_code": {
          "maxLength": 2,
          "minLength": 2,
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "network_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Network Type",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "proxy": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy"
        },
        "public_ip_observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Ip Observed"
        },
        "vantage_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Vantage Id",
          "type": "string"
        }
      },
      "required": [
        "vantage_id",
        "country_code",
        "network_type"
      ],
      "title": "NetworkVantage",
      "type": "object"
    },
