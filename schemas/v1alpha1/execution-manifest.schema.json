  "$id": "urn:communication-privacy-benchmark:schema:execution-manifest:1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Adapter Ids",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completion": {
      "$ref": "#/$defs/CompletionState"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "github": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitHubProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubjectObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "repetition": {
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
