{
  "$defs": {
    "GitHubProvenance": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit Sha",
          "type": "string"
        },
        "job": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Job",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "run_attempt": {
          "exclusiveMinimum": 0,
          "title": "Run Attempt",
          "type": "integer"
        },
        "run_id": {
          "exclusiveMinimum": 0,
          "title": "Run Id",
          "type": "integer"
        },
        "workflow": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "workflow",
        "job",
        "run_id",
        "run_attempt",
        "commit_sha"
      ],
      "title": "GitHubProvenance",
      "type": "object"
    },
    "SubjectRef": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Subject Version",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "subject_version"
      ],
      "title": "SubjectRef",
      "type": "object"
    }
  },
  "$id": "urn:communication-privacy-benchmark:schema:publication-receipt:1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only record that one canonical bundle was offered for publication.\n\nA receipt is not a benchmark result and never carries a finding of its own. It\nrecords *that* a bundle cleared the operational gate, *which* bundle it was by\ncontent digest, and under which policy revision, so a later reader can prove the\nbundle was published deliberately rather than reconstructed after the fact. The\ntransport itself (release asset upload and attestation) is performed by the\npublishing workflow; the receipt is the harness's own evidence that it offered the\nbundle under a named policy.",
  "properties": {
    "attested": {
      "title": "Attested",
      "type": "boolean"
    },
    "bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "bundle_id": {
      "format": "uuid",
      "title": "Bundle Id",
      "type": "string"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "github": {
      "$ref": "#/$defs/GitHubProvenance"
    },
    "operations_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operations Id",
      "type": "string"
    },
    "operations_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Operations Version",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "result_count": {
      "minimum": 0,
      "title": "Result Count",
      "type": "integer"
    },
    "retention_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Retention Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1alpha1",
      "default": "1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/SubjectRef"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    },
    "suite_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Suite Version",
      "type": "string"
    },
    "target": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "published_at",
    "target",
    "operations_id",
    "operations_version",
    "bundle_id",
    "bundle_digest",
    "plan_id",
    "suite_id",
    "suite_version",
    "github",
    "subjects",
    "result_count",
    "evidence_count",
    "retention_policy_id",
    "attested"
  ],
  "title": "PublicationReceipt",
  "type": "object"
}
